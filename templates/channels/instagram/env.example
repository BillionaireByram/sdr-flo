# SDR Flo IG adapter env (copy to .env, root 0600). Placeholders only — never commit real secrets.

# --- shadow gate: drafts + persists everything, sends NOTHING. Flip to false only after Byram authenticates. ---
SDR_FLO_DRAFT_ONLY=true
IG_PUBLIC_REPLY_ENABLED=false
IG_PRIVATE_REPLY_ENABLED=false

# --- Meta / Instagram (official Graph API) ---
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=change-me-webhook-verify
META_GRAPH_VERSION=v21.0
META_IG_USER_ID=            # the IG business account id that owns messaging
PAGE_ACCESS_TOKEN=          # long-lived page/IG token (instagram_basic, instagram_manage_comments, instagram_manage_messages)

# --- reasoning (Byram-voice brain). Empty => offline template draft for shadow/tests. ---
RELAY_BRIDGE=              # e.g. http://127.0.0.1:8787/v1/chat/completions (Codex or Claude Max bridge)
RELAY_MODEL=claude-sonnet-4-6
IG_SOUL=SOUL.byram.md
IG_CONFIG=config.example.json

# --- spine ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- runtime ---
IG_PORT=8820
IG_DB=ig_state.db
