# SDR Flo relay env (copy to /opt/sdr-flo/.env, root 0600). Placeholders only — never commit real secrets.

# --- relay ---
RELAY_WEBHOOK_SECRET=change-me
RELAY_PORT=8799
RELAY_DB=/opt/sdr-flo/agent/state.db
RELAY_LOG=/opt/sdr-flo/agent/agent.log.jsonl
RELAY_LIVE=false                         # dry-run until validated
RELAY_SOUL=/opt/sdr-flo/profile/SOUL.md
RELAY_ENABLE_TAG=ai-dm-start             # fail-closed gate: only engage leads with this tag
RELAY_GUARD_TAGS=existing-client,manual,dnd,ai off,do-not-contact
RELAY_KEYWORDS=                          # comma list; a lead OPENING with one self-tags (catches CRM tag misses)

# --- reasoning backend (pluggable, OpenAI-compatible) ---
# MOST STABLE = a DEDICATED PROVIDER API KEY (no OAuth token to expire or share across machines).
# Lesson (Takeoff): a shared Claude Max OAuth token rotated across two VMs and died silently -> outage.
#   GLM (recommended): api.z.ai coding plan, model glm-4.6, set RELAY_BRAIN_KEY to the provider key.
#   Codex (ai-flo -z) or a local Claude Max CLI bridge also work (leave RELAY_BRAIN_KEY=x for a no-auth bridge).
RELAY_BRIDGE=https://api.z.ai/api/coding/paas/v4/chat/completions
RELAY_MODEL=glm-4.6                      # fast + clean. Avoid glm-5.2 for real-time (reasoning-heavy, empty without huge budgets)
RELAY_BRAIN_KEY=change-me                # provider API key; "x" if pointing at a no-auth local bridge
RELAY_BRAIN_MAX_TOKENS=1024

# --- channel: GHL Conversations (IG/FB/TikTok/SMS) ---
GHL_PIT=pit-xxxxxxxx
GHL_LOC=xxxxxxxx                         # location id (used by the uptime watchdog conversation scan)
GHL_MSG_TYPE=IG                          # IG | FB | TIKTOK | SMS

# --- spine ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=xxxx

# --- uptime watchdog (proactive: spots -> fixes -> reports; watches every conversation) ---
WATCHDOG_AGENT_URL=http://127.0.0.1:8799/ghl-ig   # relay inbound endpoint, to re-poke stuck conversations
WATCHDOG_AGENT_PORT=8799
WATCHDOG_AGENT_SERVICE=sdr-flo-relay.service      # systemd unit the watchdog restarts on failure
WATCHDOG_STUCK_MIN=4                               # a lead waiting longer than this gets re-poked
SLACK_BOT_TOKEN=xoxb-xxxx                          # ops alerts
SLACK_OPS_CHANNEL=Cxxxxxxx                         # channel for watchdog reports
WATCHDOG_ESCALATE_MENTION=                         # slack user id to @mention ONLY for unfixable issues (blank = none)
WATCHDOG_VERBOSE=0                                 # 0 = quiet (Slack only for issues needing a human); 1 = also post fixes/recoveries + weekly heartbeat

# --- intelligence (intel.env) ---
# INTEL_DRY=1                            # 1 = shadow/report-only, 0 = live self-optimize
