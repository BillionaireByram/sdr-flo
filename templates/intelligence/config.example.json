{
  "client": "client-slug",
  "display_name": "Client Name",
  "state_db": "/opt/sdr-flo/agent/state.db",
  "log": "/opt/sdr-flo/agent/agent.log.jsonl",
  "bridge": "https://api.z.ai/api/coding/paas/v4/chat/completions",
  "model": "glm-4.6",
  "service": "sdr-flo-relay",
  "vault_reports": "/root/.claude/shared-memory/wiki/clients/CLIENT_SLUG/intelligence",
  "keep_versions": 30,
  "targets": { "hit_rate": 0.30 },
  "min_convos": { "daily": 4, "weekly": 12 },
  "max_transcripts_to_llm": 30,
  "motions": {
    "COMMUNITY": {
      "soul": "/opt/sdr-flo/profile/SOUL.md",
      "objective_label": "send them the community link (push to the paid/free community)",
      "outcome_name": "link sent",
      "objective_marker": "YOUR_TRACKED_LINK_SLUG",
      "objective_kind": "marker",
      "protected": ["## CONTINUITY", "## DESTINATION", "<YOUR_OFFER_ANCHOR>", "<YOUR_REP_NAME>", "<YOUR_PRODUCT_NAME>"]
    },
    "BOOK": {
      "soul": "/opt/sdr-flo/profile/SOUL_BOOK.md",
      "objective_label": "book the consultation call",
      "outcome_name": "call booked",
      "objective_marker": "__BOOKED__",
      "objective_kind": "book",
      "protected": ["<YOUR_QUALIFY_THRESHOLD>", "<YOUR_REP_NAME>", "calendar"]
    }
  },
  "gauntlet": {
    "COMMUNITY": [
      {"name": "continuity_no_restart",
       "history": [["assistant","Nice to meet you. What is the best number to reach you at?"],["user","5551234567"]],
       "user": "my email is lead@example.com",
       "fail_if": ["you reached out","what's good","what is good","point you in the right direction","were you looking for help"],
       "pass_if": ["link","your_tracked_link_slug","email","<your_product_name>"]},
      {"name": "drive_to_objective",
       "history": [["user","yeah I am interested in what you offer"],["assistant","Got it. Are you ready to move now or want to learn more first?"],["user","learn more first I guess"]],
       "user": "ok yeah that makes sense",
       "fail_if": ["you reached out"],
       "pass_if": ["link","<your_product_name>","name","full name"]},
      {"name": "no_dashes",
       "history": [],
       "user": "what do you guys actually do",
       "fail_if": [" - ","—","–"],
       "pass_if": []}
    ],
    "BOOK": [
      {"name": "qualify_progress",
       "history": [["user","yes im interested"]],
       "user": "here is my situation <qualifying detail>",
       "fail_if": ["you reached out","what's good"],
       "pass_if": ["<qualifier_1>","<qualifier_2>","<qualifier_3>"]},
      {"name": "no_dashes",
       "history": [],
       "user": "how does this work",
       "fail_if": [" - ","—","–"],
       "pass_if": []}
    ]
  }
}
